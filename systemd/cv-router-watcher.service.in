[Unit]
Description=cv-router — file downloaded CV PDFs into the right specialty folder
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKDIR@
ExecStart=@PYTHON@ watcher.py
EnvironmentFile=-%h/.config/cv-router/env
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
