# your machine, your data — never committed
config.toml
data/
*.pdf

.venv/
__pycache__/
*.pyc

# graphify (regenerable, large)
graphify-out/cache/
graphify-out/cost.json
graphify-out/graph.json

# pipeline: your data
pipeline.toml
profile.toml
applications/

# Canada Resume Studio: your own config and its output. The example config is
# tracked; canada.toml is yours. Output never goes near watch_dir.
canada_module/canada.toml
canada_module/output/

# graphify output: regenerated by a hook on every commit, and
# .graphify_root records an absolute path from the machine that built it.
graphify-out/

# A third-party skill, MIT, from nextlevelbuilder/ui-ux-pro-max-skill. Installed
# per project so it loads here and nowhere else, ignored because 3.7 MB of font
# and icon catalogues do not belong in a CV router's public history. Reinstall
# with: git clone --depth 1 <that repo> && cp -r .claude/skills/ui-ux-pro-max ...
.claude/skills/ui-ux-pro-max/

# UX review screenshots: they are captures of the running app with the real
# collection in it, so they hold company names, application history, a phone
# number and absolute paths. The review that references them is committed; the
# pictures are not.
ux-review-shots/

# demo video: frames and renders are large and regenerable
demo-video/out/
demo-video/*.mp4
demo-video/*.mp3
demo-video/*.wav
demo-video/*.m4a
demo-video/
